# .gitignore for Django Dev Pro Skill

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Note: the source package lives in ./lib and must be tracked.
# build/lib/ is already covered by build/ above.

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Configuration (user-specific)
~/.django-dev-pro/
.env
.env.local
.env.*.local

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Project-specific caches
configs/project_commands.json
.cache/
*.pyc
